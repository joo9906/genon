# =====================================================================================
# GenOS Embedding / VectorDB  (QS 전용 — 이름 충돌 방지용 접미사)
# =====================================================================================

class GenOSEmbeddingQS:
    def __init__(self, serving_id: str, bearer_token: str, genos_url: str):
        self.serving_id = serving_id
        self.url = f"{genos_url}/api/gateway/rep/serving/{serving_id}"
        self.headers = dict(Authorization=f"Bearer {bearer_token}")
        if serving_id and bearer_token:
            print(f"[EMB] embedding model: {serving_id}번 준비")
        else:
            print("[EMB] serving id 혹은 인증키가 입력되지 않았습니다.")

    @retry(stop=stop_after_attempt(3), wait=wait_exponential(min=1, max=10), reraise=True,
           retry=retry_if_exception_type(requests.RequestException))
    def call_batch(self, questions: list) -> list:
        body = {"input": questions}
        endpoint = f"{self.url}/v1/embeddings"
        response = requests.post(endpoint, headers=self.headers, json=body, timeout=30)
        response.raise_for_status()
        data = response.json()["data"]
        return sorted(data, key=lambda d: d.get("index", 0)) if isinstance(data, list) else data

    def call(self, question: str = "안녕?"):
        return self.call_batch([question])


class GenOSVectorDBQS:
    def __init__(
        self,
        idx: str,
        weaviate_api_key: str,
        embedding_serving_id: str,
        embedding_bearer_token: str,
        genos_ip: str = WEAVIATE_URL,
        http_port: int = WEAVIATE_HTTP_PORT,
        grpc_port: int = WEAVIATE_GRPC_PORT,
        embedding_genos_url: str = GENOS_URL,
    ):
        if not weaviate_api_key:
            raise ValueError("Weaviate API Key가 누락되었습니다.")

        try:
            self.client = weaviate.connect_to_custom(
                http_host=genos_ip,
                http_port=http_port,
                http_secure=False,
                grpc_host=genos_ip,
                grpc_port=grpc_port,
                grpc_secure=False,
                auth_credentials=AuthApiKey(weaviate_api_key),
            )
        except Exception as e:
            raise RuntimeError(f"Weaviate 접속 중 오류 발생: {e}")

        if not idx:
            raise ValueError("벡터 인덱스(vdb_index)가 누락되었습니다.")

        try:
            self.collection = self.client.collections.get(idx)
        except Exception as e:
            self.close()
            raise RuntimeError(f"Collection 조회 중 오류 발생: {e}")

        self.emb = GenOSEmbeddingQS(
            serving_id=str(embedding_serving_id),
            bearer_token=embedding_bearer_token,
            genos_url=embedding_genos_url,
        )

    def hybrid_search(self, query: str, topk: int = 4, alpha: float = 0.5, vector: list = None):
        if vector is None:
            vector = self.emb.call(query)[0]["embedding"]
        results = self.collection.query.hybrid(
            query=query, vector=vector, alpha=alpha, limit=topk
        ).objects
        return [obj.properties for obj in results]

    def close(self):
        if getattr(self, "client", None) is not None:
            try:
                self.client.close()
            except Exception:
                pass


_QS_VDB_CACHE: dict = {}

def _qs_get_vdb(idx: str, api_key: str, emb_id: str, emb_token: str) -> GenOSVectorDBQS:
    key = f"{idx}_{api_key}_{emb_id}"
    if key not in _QS_VDB_CACHE:
        _QS_VDB_CACHE[key] = GenOSVectorDBQS(
            idx=idx, weaviate_api_key=api_key,
            embedding_serving_id=emb_id, embedding_bearer_token=emb_token,
        )
    return _QS_VDB_CACHE[key]


# =====================================================================================
# 복호화 / 결과 정리 유틸  (QS 전용)
# =====================================================================================

_QS_DERIVED_KEY_CACHE: dict = {}

def _qs_derive_key(key: str) -> bytes:
    if key not in _QS_DERIVED_KEY_CACHE:
        kdf = PBKDF2HMAC(
            algorithm=hashes.SHA256(), length=32, salt=b"genos",
            iterations=100000, backend=default_backend(),
        )
        _QS_DERIVED_KEY_CACHE[key] = kdf.derive(key.encode("utf-8"))
    return _QS_DERIVED_KEY_CACHE[key]


def _qs_decrypt(ciphertext: str, key: str = DECRYPT_KEY):
    derived_key = _qs_derive_key(key)
    ciphertext_bytes = base64.b64decode(ciphertext.encode("utf-8"))
    iv = ciphertext_bytes[:12]
    tag = ciphertext_bytes[12:28]
    actual_ciphertext = ciphertext_bytes[28:]

    decryptor = Cipher(
        algorithms.AES(derived_key), modes.GCM(iv, tag), backend=default_backend(),
    ).decryptor()
    decryptor.authenticate_additional_data(b"")
    decrypted = decryptor.update(actual_ciphertext) + decryptor.finalize()
    text = decrypted.decode("utf-8")

    try:
        return json.loads(text)
    except (json.JSONDecodeError, ValueError):
        return text


def _qs_maybe_decrypt(doc: dict):
    text = doc.get("text")
    if not isinstance(text, str) or not text:
        return text
    try:
        return _qs_decrypt(text)
    except Exception:
        return text


# 문서 출처 표시(sourceDocuments)용 메타데이터. Weaviate 속성에 존재할 때만 포함한다.
_QS_DOC_META_FIELDS = ("file_name", "file_path", "i_page", "security_level", "i_chunk_on_doc")

def _qs_project(docs: list) -> list:
    out = []
    for d in docs:
        if not isinstance(d, dict):
            continue
        item = {"doc_id": d.get("doc_id"), "text": _qs_maybe_decrypt(d), "summary": d.get("summary")}
        for f in _QS_DOC_META_FIELDS:
            if d.get(f) is not None:
                item[f] = d[f]
        out.append(item)
    return out


def _qs_finish(docs: list, diag: dict, debug: bool) -> str:
    if debug:
        return json.dumps({"result": docs, "_debug": diag}, ensure_ascii=False)
    return json.dumps(docs, ensure_ascii=False)


# =====================================================================================
# variables 주입  (mcp_v2.py와 동일 메커니즘, QS 전용 이름)
# =====================================================================================

_QS_RESOURCE_VARS_CACHE: dict = {"loaded": False, "data": {}}

def _qs_load_resource_variables(filename: str = None) -> dict:
    """GenOS '리소스 목록'에 업로드한 설정 JSON(예: variables.json)을 찾아 읽는다.
    한 번 읽으면 캐싱하며, 못 찾으면 빈 dict를 반환(개별 인자/variables만 사용).
    실제 GenOS 마운트 경로가 다르면 로그의 '못 찾음'을 보고 VARIABLES_PATH만 지정하면 된다.
    """
    if _QS_RESOURCE_VARS_CACHE["loaded"]:
        return _QS_RESOURCE_VARS_CACHE["data"]

    filename = filename or os.getenv("VARIABLES_FILE", "variables.json")

    try:
        here = os.path.dirname(os.path.abspath(__file__))
    except NameError:  # GenOS가 소스를 exec하면 __file__이 없을 수 있음
        here = os.getcwd()

    candidates = []
    if os.getenv("VARIABLES_PATH"):
        candidates.append(os.getenv("VARIABLES_PATH"))
    for env_key in ("GENOS_RESOURCE_DIR", "RESOURCE_DIR", "RESOURCES_DIR"):
        d = os.getenv(env_key)
        if d:
            candidates.append(os.path.join(d, filename))
    candidates += [
        os.path.join(here, filename),
        os.path.join(here, "resources", filename),
        os.path.join(os.getcwd(), filename),
        os.path.join(os.getcwd(), "resources", filename),
        os.path.join("/app/resources", filename),
        os.path.join("/resources", filename),
    ]

    data = {}
    for path in candidates:
        try:
            if path and os.path.isfile(path):
                with open(path, "r", encoding="utf-8") as f:
                    parsed = json.load(f)
                if isinstance(parsed, dict):
                    data = parsed
                    print(f"[RESOURCE] 설정 리소스 로드: {path} ({len(data)}개 키)")
                    break
        except Exception as e:
            print(f"[RESOURCE] {path} 읽기 실패: {e!r}")

    if not data:
        print(f"[RESOURCE] '{filename}' 리소스를 못 찾음 → 개별 인자/variables만 사용")

    _QS_RESOURCE_VARS_CACHE["loaded"] = True
    _QS_RESOURCE_VARS_CACHE["data"] = data
    return data


def _qs_parse_variables(variables) -> dict:
    """GenOS가 '{...}' 형식으로 주입하는 variables를 dict로 정규화한다.
    JSON 문자열/딕셔너리/이중 인코딩 문자열을 모두 처리하며, 실패 시 빈 dict를 반환.
    """
    if not variables:
        return {}
    if isinstance(variables, dict):
        return variables
    if isinstance(variables, str):
        raw = variables.strip()
        if not raw:
            return {}
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError as e:
            print(f"[VARS] variables JSON 파싱 실패 → 무시: {e!r}")
            return {}
        if isinstance(parsed, str):  # 이중 인코딩 방어
            try:
                parsed = json.loads(parsed)
            except json.JSONDecodeError:
                return {}
        return parsed if isinstance(parsed, dict) else {}
    return {}


