# =====================================================================================
# MCP Tool : quick_search
# =====================================================================================

@mcp.tool()
async def quick_search(
    query: str | list,
    # GenOS는 값이 없을 때 None이 아니라 빈 문자열("")을 주입한다. MCP는 본문(_pick) 전에
    # 타입 검증을 하므로, int/float/bool로 좁게 선언하면 ""에서 검증 에러가 난다.
    # → str까지 허용하고, 실제 캐스팅/폴백은 아래 _pick + int()/float()/bool 정규화에서 처리한다.
    topk: int | str | None = None,
    alpha: float | str | None = None,
    vdb_index: str | None = None,
    vdb_api_key: str | None = None,
    embedding_serving_id: str | None = None,
    embedding_bearer_token: str | None = None,
    debug: bool | str | None = None,
    variables: str | dict = "",  # GenOS가 '{...}' 형식으로 주입하는 설정 묶음(기초 기본값)
) -> str:
    """[언제 쓰나] 단순·명확한 단일 사실/정의/수치 질문의 기본 검색 도구. 빠르고 저렴하다.
    → 질문이 복잡·모호·다면적이거나 이 도구 결과가 부실하면 대신 deep_search를 사용하라.

    빠른 단발 하이브리드 검색(quick_search) 전략 도구.
    HyDE·멀티쿼리·리랭킹 없이 단일 질문을 곧바로 Weaviate 하이브리드 검색해 문서를 반환합니다.
    정교한 검색(HyDE/멀티쿼리/리랭킹 토글)이 필요하면 deep 전략인 deep_search를 사용하세요.

    Args:
        query: 검색할 질문. 리스트/JSON 배열이 오면 첫 유효 항목만 사용합니다(단일 질문 전략).
        topk: 반환 문서 개수. 기본값 10.
        alpha: 하이브리드 가중치(1.0=벡터 only, 0.0=BM25 only). 기본값 0.5.
        vdb_index / vdb_api_key: Weaviate 인덱스 및 API 키.
        embedding_serving_id / embedding_bearer_token: 임베딩 서빙 정보.
        debug: True면 반환에 _debug(진단) 동봉.
        variables: '{...}' 형식(문자열/딕셔너리) '기초 기본값' 묶음. 개별 인자의 폴백으로 쓰이며,
            개별 인자를 명시적으로 넘기면 그 값이 variables보다 우선합니다(사용자 입력 최우선).

    Returns:
        JSON 문자열. 각 항목은 { "doc_id", "text", "summary",
        (file_name, file_path, i_page, security_level, i_chunk_on_doc) }.
        file_name/file_path/i_page 등은 Weaviate 속성에 있을 때만 포함(출처 표시용).
    """
    # 0) 설정 해석. 우선순위(높음→낮음):
    #    개별 인자(사용자 입력) > variables(호출 blob) > variables.json(업로드 리소스) > 하드코딩 기본값.
    #    개별 인자는 None(문자열은 "")이면 '안 넘김'으로 보고 아래 단계로 폴백한다.
    _vars = {**_qs_load_resource_variables(), **_qs_parse_variables(variables)}

    def _pick(arg_val, *keys, default):
        if arg_val is not None and arg_val != "":  # 사용자가 명시적으로 넘긴 값이 최우선
            return arg_val
        for k in keys:
            if _vars.get(k) is not None:
                return _vars[k]
        return default

    topk = _pick(topk, "topk", default=10)
    alpha = _pick(alpha, "alpha", default=0.5)
    vdb_index = _pick(vdb_index, "vdb_index", default="")
    vdb_api_key = _pick(vdb_api_key, "vdb_api_key", default="")
    embedding_serving_id = _pick(embedding_serving_id, "embedding_serving_id", default="")
    embedding_bearer_token = _pick(embedding_bearer_token, "embedding_bearer_token", default="")
    debug = _pick(debug, "debug", default=False)

    # query: 사용자 입력 최우선. 비어 있을 때만(""/[]) variables의 query로 폴백.
    if not query:
        _q = _vars.get("query")
        if _q:
            query = _q

    debug = str(debug).lower() not in ("false", "0", "no", "")
    diag = {"steps": [], "query": None, "counts": {}, "errors": [], "sample_keys": None}

    def _dbg(msg):
        diag["steps"].append(str(msg))
        print(msg)

    print("\n" + "#" * 100)
    print("[TOOL] quick_search 시작 (단발 하이브리드 검색)")
    print(f"[INPUT] topk={topk} alpha={alpha} vdb_index={vdb_index!r}")
    print("#" * 100)

    try:
        # 1) 파라미터 캐스팅
        topk = int(topk)
        alpha = float(alpha)

        # 2) query 정규화 — quick_search는 단일 질문. 리스트/JSON 배열이 오면 첫 유효값만 사용.
        if isinstance(query, str):
            try:
                parsed_q = json.loads(query)
                if isinstance(parsed_q, list):
                    query = parsed_q
            except json.JSONDecodeError:
                pass  # 평범한 단일 텍스트 → 그대로 사용
        if isinstance(query, list):
            valid = [str(q).strip() for q in query if str(q).strip()]
            q = valid[0] if valid else ""
        else:
            q = str(query).strip()

        diag["query"] = q
        if not q:
            diag["errors"].append("유효한 query가 없습니다.")
            return _qs_finish([], diag, debug)

        # 3) VectorDB 초기화
        try:
            vdb = _qs_get_vdb(
                idx=vdb_index, api_key=vdb_api_key,
                emb_id=str(embedding_serving_id), emb_token=embedding_bearer_token,
            )
        except Exception as e:
            diag["errors"].append(f"VDB 초기화 실패: {e!r}")
            return _qs_finish([], diag, debug)

        # 4) 단발 하이브리드 검색 (blocking client → to_thread)
        try:
            docs = await asyncio.to_thread(
                vdb.hybrid_search, query=q, topk=topk, alpha=alpha,
            )
            docs = list(docs) if docs else []
        except Exception as e:
            diag["errors"].append(f"검색 실패: {e!r}")
            _dbg(f"[QS] 검색 실패: {e}")
            return _qs_finish([], diag, debug)

        diag["counts"]["hits"] = len(docs)
        if docs:
            diag["sample_keys"] = list(docs[0].keys())
        _dbg(f"[QS] 검색 결과 {len(docs)}건 반환")

        return _qs_finish(_qs_project(docs), diag, debug)

    except Exception as e:
        print("[FATAL ERROR]")
        print(traceback.format_exc())
        diag["errors"].append(f"FATAL: {e!r}")
        diag["traceback"] = traceback.format_exc()
        return _qs_finish([], diag, debug)

    finally:
        print("#" * 100)
        print("[TOOL] quick_search 종료")
        print("#" * 100 + "\n")